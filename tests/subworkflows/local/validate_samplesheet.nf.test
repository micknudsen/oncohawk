nextflow_function {
    name 'Validate sample sheet'
    script '../../../subworkflows/local/validate_samplesheet.nf'
    function 'validateSamplesheet'

    test('normalizes a valid synthetic sample sheet') {
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/fixtures/valid.csv")
                """
            }
        }

        then {
            assert function.success
            assert function.result.size() == 3
            assert function.result[0].patient_id == 'patient_001'
            assert function.result[0].platform == 'ILLUMINA'
            assert function.result[0].barcode == null
            assert function.result[0].read_group_id == 'sample_001.lib_A.FC123.001'
            assert function.result[0].platform_unit == function.result[0].read_group_id
            assert function.result[0].r1_path.endsWith('lib_A_FC123_L001_R1_001.fastq.gz')
            assert function.result[0].r2_path.endsWith('lib_A_FC123_L001_R2_001.fastq.gz')
            assert function.result[1].r1_path.endsWith('lib_A_FC123_L002_R1.fq.gz')
            assert function.result[1].r2_path.endsWith('lib_A_FC123_L002_R2.fq.gz')
        }
    }

    test('derives a barcode-based platform unit') {
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/fixtures/valid_barcode.csv")
                """
            }
        }

        then {
            assert function.success
            assert function.result == [[
                patient_id: 'patient_001', sample_id: 'sample_001', library_id: 'lib_A',
                flowcell_id: 'FC123', lane: '001', platform: 'ILLUMINA', barcode: 'ACGT+TGCA',
                read_group_id: 'sample_001.lib_A.FC123.001', platform_unit: 'FC123.001.ACGT%2BTGCA',
                r1_path: "${projectDir}/tests/fixtures/fastq/sample_001/lib_A_FC123_L001_R1.fastq.gz",
                r2_path: "${projectDir}/tests/fixtures/fastq/sample_001/lib_A_FC123_L001_R2.fastq.gz"
            ]]
        }
    }

    test('percent-encodes read-group components') {
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/fixtures/valid_encoded_identifiers.csv")
                """
            }
        }

        then {
            assert function.success
            assert function.result[0].read_group_id == 'sample%2E001.lib%25A.FC%2E123.00%2E1'
            assert function.result[0].platform_unit == function.result[0].read_group_id
        }
    }

    test('accepts FASTQ paths through symlinks') {
        def fixtureDirectory = new File("${projectDir}/.nf-test/path-preflight-symlink")
        def sampleSheet = new File(fixtureDirectory, 'samples.csv')

        when {
            fixtureDirectory.deleteDir()
            fixtureDirectory.mkdirs()
            def r1Target = new File(fixtureDirectory, 'target_R1.fastq.gz')
            def r2Target = new File(fixtureDirectory, 'target_R2.fastq.gz')
            r1Target.text = 'synthetic R1\n'
            r2Target.text = 'synthetic R2\n'
            java.nio.file.Files.createSymbolicLink(new File(fixtureDirectory, 'linked_R1.fastq.gz').toPath(), r1Target.toPath())
            java.nio.file.Files.createSymbolicLink(new File(fixtureDirectory, 'linked_R2.fastq.gz').toPath(), r2Target.toPath())
            sampleSheet.text = """patient_id,sample_id,filetype,info,filepath
patient_001,sample_001,fastq,library_id:lib_A;flowcell_id:FC123;lane:001,linked_R1.fastq.gz;linked_R2.fastq.gz
"""
            function {
                """
                input[0] = file("${sampleSheet}")
                """
            }
        }

        then {
            assert function.success
        }
    }

    [
        [name: 'a missing FASTQ path', r1: 'missing_R1.fastq.gz', r2: 'present_R2.fastq.gz', diagnostic: 'R1 path does not exist'],
        [name: 'a non-regular FASTQ path', r1: 'directory_R1.fastq.gz', r2: 'present_R2.fastq.gz', diagnostic: 'R1 must resolve to a regular file'],
        [name: 'symlink aliases for R1 and R2', r1: 'alias_R1.fastq.gz', r2: 'alias_R2.fastq.gz', diagnostic: 'R1 and R2 must resolve to distinct files'],
        [name: 'hard-link aliases for R1 and R2', r1: 'target_R1.fastq.gz', r2: 'hardlink_R2.fastq.gz', diagnostic: 'R1 and R2 must resolve to distinct files']
    ].each { scenario ->
        test("rejects ${scenario.name}") {
            def fixtureDirectory = new File("${projectDir}/.nf-test/path-preflight-${scenario.name.replaceAll('[^a-z]+', '-')}")
            def sampleSheet = new File(fixtureDirectory, 'samples.csv')

            when {
                fixtureDirectory.deleteDir()
                fixtureDirectory.mkdirs()
                def r1Target = new File(fixtureDirectory, 'target_R1.fastq.gz')
                def r2Target = new File(fixtureDirectory, 'present_R2.fastq.gz')
                r1Target.text = 'synthetic R1\n'
                r2Target.text = 'synthetic R2\n'
                new File(fixtureDirectory, 'directory_R1.fastq.gz').mkdirs()
                java.nio.file.Files.createSymbolicLink(new File(fixtureDirectory, 'alias_R1.fastq.gz').toPath(), r1Target.toPath())
                java.nio.file.Files.createSymbolicLink(new File(fixtureDirectory, 'alias_R2.fastq.gz').toPath(), r1Target.toPath())
                java.nio.file.Files.createLink(new File(fixtureDirectory, 'hardlink_R2.fastq.gz').toPath(), r1Target.toPath())
                sampleSheet.text = """patient_id,sample_id,filetype,info,filepath
patient_001,sample_001,fastq,library_id:lib_A;flowcell_id:FC123;lane:001,${scenario.r1};${scenario.r2}
"""
                function {
                    """
                    input[0] = file("${sampleSheet}")
                    """
                }
            }

            then {
                assert function.failed
                assert function.stdout.any { line -> line.contains(scenario.diagnostic) }
            }
        }
    }

    [
        'invalid_header.csv': 'header: expected exactly',
        'invalid_missing_field.csv': 'sample_id: value is required',
        'invalid_filetype.csv': "filetype: must equal 'fastq'",
        'invalid_info.csv': "info: unknown key 'unknown'",
        'invalid_duplicate_info.csv': "info: key 'library_id' must occur exactly once",
        'invalid_paths.csv': 'filepath: first path must name a .fastq.gz or .fq.gz file with an R1 mate token',
        'invalid_missing_fastq.csv': 'R1 path does not exist',
        'invalid_mapping.csv': "sample_id: 'sample_001' maps to more than one patient_id",
        'invalid_tuple.csv': 'duplicate (sample_id, library_id, flowcell_id, lane) tuple',
        'invalid_quoted_field.csv': 'quoted CSV fields are not supported',
        'invalid_whitespace.csv': 'sample_id: whitespace is not permitted',
        'invalid_barcode.csv': 'barcode must be one uppercase IUPAC DNA sequence or dual sequences joined by +',
        'invalid_lowercase_platform.csv': 'platform must be one of',
        'invalid_platform.csv': 'platform must be one of',
        'invalid_platform_unit_collision.csv': 'duplicate generated platform_unit'
    ].each { fixture, diagnostic ->
        test("rejects ${fixture}") {
            when {
                function {
                    """
                    input[0] = file("${projectDir}/tests/fixtures/${fixture}")
                    """
                }
            }

            then {
                assert function.failed
                assert function.stdout.any { line -> line.contains(diagnostic) }
            }
        }
    }
}
