nextflow_pipeline {
    name 'Run main workflow'
    script '../main.nf'
    config './nextflow.config'

    test('stubs default reference-bundle preparation without downloading GRCh38') {
        def outputRoot = new File("${projectDir}/.nf-test/reference-bundle")

        options '-stub'

        when {
            outputRoot.deleteDir()
            params {
                delegate.setProperty('workflow', 'prepare_reference_bundle')
                outdir = outputRoot.toString()
            }
        }

        then {
            assert workflow.success
            def fasta = new File(outputRoot, 'fasta/GCA_000001405.15_GRCh38_no_alt_analysis_set.masked.fna')
            def manifest = new groovy.json.JsonSlurper().parse(new File(outputRoot, 'manifest.json'))
            assert fasta.isFile()
            assert !new File(outputRoot, 'reference').exists()
            assert manifest.schema_version == 1
            assert manifest.bundle_id == 'oncohawk-reference-hg38-beta-2'
            assert manifest.reference == [
                assembly: 'GCA_000001405.15_GRCh38',
                contig_naming: 'ucsc',
                source_fasta: [
                    filename: 'GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz',
                    url: 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz',
                    md5: 'a08035b6a6e31780e96a34008ff21bd6'
                ],
                masked_fasta: [
                    path: 'fasta/GCA_000001405.15_GRCh38_no_alt_analysis_set.masked.fna',
                    sha256: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
                ]
            ]
            assert manifest.mask == [
                method: 'bedtools_maskfasta',
                bed: [
                    filename: 'GCA_000001405.15_GRCh38_GRC_exclusions.bed',
                    url: 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_GRC_exclusions.bed',
                    md5: 'bf5c011e0342f355422144eb3547b5d0'
                ],
                replacement_base: 'N',
                coordinate_system: '0-based-half-open'
            ]
            assert !manifest.containsKey('indexing')
        }
    }

    test('rejects a source checksum override') {
        def outputRoot = new File("${projectDir}/.nf-test/reference-bundle-bad-checksum")

        options '-stub'

        when {
            outputRoot.deleteDir()
            params {
                delegate.setProperty('workflow', 'prepare_reference_bundle')
                outdir = outputRoot.toString()
                reference_fasta_md5 = '00000000000000000000000000000000'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Parameter --reference_fasta_md5 is not valid for --workflow prepare_reference_bundle') }
        }
    }

    test('accepts a valid synthetic sample sheet') {
        def outputRoot = "${projectDir}/.nf-test/compatibility-record"

        when {
            new File(outputRoot).deleteDir()
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.success
            def record = new File(outputRoot, 'metadata/bundle-compatibility.json')
            assert record.isFile()
            assert new groovy.json.JsonSlurper().parse(record) == [
                reference_bundle_id: 'reference-test-001',
                knowledge_bundle_id: 'knowledge-test-001',
                knowledge_source_reference_bundle_id: 'reference-test-001'
            ]
        }
    }

    test('preserves a matching compatibility record') {
        def outputRoot = new File("${projectDir}/.nf-test/existing-compatibility-record")
        def expectedRecord = '''{
    "reference_bundle_id": "reference-test-001",
    "knowledge_bundle_id": "knowledge-test-001",
    "knowledge_source_reference_bundle_id": "reference-test-001"
}
'''

        when {
            outputRoot.deleteDir()
            outputRoot.mkdirs()
            def metadataDirectory = new File(outputRoot, 'metadata')
            metadataDirectory.mkdirs()
            new File(metadataDirectory, 'bundle-compatibility.json').text = expectedRecord
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.success
            assert new File(outputRoot, 'metadata/bundle-compatibility.json').text == expectedRecord
        }
    }

    test('rejects a conflicting existing compatibility record without replacing it') {
        def outputRoot = new File("${projectDir}/.nf-test/conflicting-compatibility-record")
        def conflictingRecord = new File(outputRoot, 'metadata/bundle-compatibility.json')

        when {
            outputRoot.deleteDir()
            conflictingRecord.parentFile.mkdirs()
            conflictingRecord.text = '{"stale":true}\n'
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Conflicting bundle compatibility record') }
            assert conflictingRecord.text == '{"stale":true}\n'
        }
    }

    test('does not create an output directory when sample-sheet preflight fails') {
        def outputRoot = new File("${projectDir}/.nf-test/invalid-sample-sheet-output")

        when {
            outputRoot.deleteDir()
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/invalid_header.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('header: expected exactly') }
            assert !outputRoot.exists()
        }
    }

    test('does not create an output directory when a declared FASTQ is missing') {
        def outputRoot = new File("${projectDir}/.nf-test/missing-fastq-output")

        when {
            outputRoot.deleteDir()
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/invalid_missing_fastq.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('R1 path does not exist') }
            assert !outputRoot.exists()
        }
    }

    test('rejects a file passed as the output directory') {
        def outputRoot = new File("${projectDir}/.nf-test/file-output-root")

        when {
            outputRoot.parentFile.mkdirs()
            outputRoot.text = 'not a directory\n'
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --outdir: expected a directory') }
            assert outputRoot.text == 'not a directory\n'
        }
    }

    test('rejects a file at the metadata path') {
        def outputRoot = new File("${projectDir}/.nf-test/file-metadata-path")
        def metadataPath = new File(outputRoot, 'metadata')

        when {
            outputRoot.deleteDir()
            outputRoot.mkdirs()
            metadataPath.text = 'not a directory\n'
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid metadata path: expected a directory') }
            assert metadataPath.text == 'not a directory\n'
        }
    }

    test('rejects an omitted workflow') {
        when {
            params {
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing or invalid required parameter: --workflow') }
        }
    }

    test('rejects an invalid workflow') {
        when {
            params {
                delegate.setProperty('workflow', 'invalid')
                outdir = 'unused-output-root'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing or invalid required parameter: --workflow') }
        }
    }

    test('rejects a missing outdir') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --outdir') }
        }
    }

    test('rejects a missing analyze input') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --input') }
        }
    }

    test('rejects a missing analyze reference bundle') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --reference_bundle') }
        }
    }

    test('rejects a missing analyze knowledge bundle') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --knowledge_bundle') }
        }
    }

    test('rejects a cross-workflow parameter') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
                reference_spec = 'custom-reference-spec'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Parameter --reference_spec is not valid for --workflow analyze') }
        }
    }

    test('rejects a missing reference bundle directory before sample-sheet validation') {
        def outputRoot = new File("${projectDir}/.nf-test/invalid-bundle-output")

        when {
            outputRoot.deleteDir()
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = outputRoot.toString()
                input = "${projectDir}/tests/fixtures/invalid_header.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/missing-reference"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --reference_bundle: expected a local bundle-root directory') }
            assert !outputRoot.exists()
        }
    }

    test('rejects a missing knowledge bundle manifest') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-missing-manifest"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --knowledge_bundle: missing manifest.json') }
        }
    }

    test('rejects a malformed reference bundle manifest') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-malformed"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --reference_bundle: malformed manifest.json') }
