nextflow_pipeline {
    name 'Run main workflow'
    script '../main.nf'
    config './nextflow.config'

    test('accepts a valid synthetic sample sheet') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.success
        }
    }

    test('rejects an omitted workflow') {
        when {
            params {
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing or invalid required parameter: --workflow') }
        }
    }

    test('rejects an invalid workflow') {
        when {
            params {
                delegate.setProperty('workflow', 'invalid')
                outdir = 'unused-output-root'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing or invalid required parameter: --workflow') }
        }
    }

    test('rejects a missing outdir') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --outdir') }
        }
    }

    test('rejects a missing analyze input') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --input') }
        }
    }

    test('rejects a missing analyze reference bundle') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --reference_bundle') }
        }
    }

    test('rejects a missing analyze knowledge bundle') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --knowledge_bundle') }
        }
    }

    test('rejects a cross-workflow parameter') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
                reference_spec = 'custom-reference-spec'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Parameter --reference_spec is not valid for --workflow analyze') }
        }
    }

    test('rejects a missing reference bundle directory before sample-sheet validation') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/invalid_header.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/missing-reference"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --reference_bundle: expected a local bundle-root directory') }
        }
    }

    test('rejects a missing knowledge bundle manifest') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-missing-manifest"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --knowledge_bundle: missing manifest.json') }
        }
    }

    test('rejects a malformed reference bundle manifest') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-malformed"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --reference_bundle: malformed manifest.json') }
        }
    }

    test('rejects an invalid reference bundle identity') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-invalid-id"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-matching"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --reference_bundle: manifest.json requires a non-empty string bundle_id') }
        }
    }

    test('rejects a knowledge bundle without its own identity') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-missing-id"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --knowledge_bundle: manifest.json requires a non-empty string bundle_id') }
        }
    }

    test('rejects a knowledge bundle without its source reference identity') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-missing-source-id"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --knowledge_bundle: manifest.json requires a non-empty string source_reference_bundle_id') }
        }
    }

    test('rejects incompatible knowledge and reference bundles before sample-sheet validation') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/invalid_header.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-mismatched"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid bundle compatibility: knowledge manifest source_reference_bundle_id does not match reference manifest bundle_id') }
        }
    }

    test('reports that reference preparation is unavailable') {
        when {
            params {
                delegate.setProperty('workflow', 'prepare_reference_bundle')
                outdir = 'unused-output-root'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("Workflow 'prepare_reference_bundle' is not implemented") }
        }
    }

    test('reports that knowledge preparation is unavailable') {
        when {
            params {
                delegate.setProperty('workflow', 'prepare_knowledge_bundle')
                outdir = 'unused-output-root'
                reference_bundle = 'reference-bundle'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("Workflow 'prepare_knowledge_bundle' is not implemented") }
        }
    }

    test('rejects a missing knowledge-preparation reference bundle') {
        when {
            params {
                delegate.setProperty('workflow', 'prepare_knowledge_bundle')
                outdir = 'unused-output-root'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Missing required parameter: --reference_bundle') }
        }
    }
}
