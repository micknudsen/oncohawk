    test('rejects a knowledge bundle without its source reference identity') {
        when {
            params {
                delegate.setProperty('workflow', 'analyze')
                outdir = 'unused-output-root'
                input = "${projectDir}/tests/fixtures/valid.csv"
                reference_bundle = "${projectDir}/tests/fixtures/bundles/reference-matching"
                knowledge_bundle = "${projectDir}/tests/fixtures/bundles/knowledge-missing-source-id"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('Invalid --knowledge_bundle: manifest.json requires a non-empty string source_reference_bundle_id') }
        }
