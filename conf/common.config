manifest {
    name = 'micknudsen/oncohawk'
    description = 'Reference preparation and alignment for Oncohawk'
    version = '0.1.0'
    nextflowVersion = '26.10.6'
    mainScript = 'main.nf'
}

process {
    cpus = 1
    memory = '2 GB'
    time = '1h'
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    slurm {
        includeConfig 'slurm.config'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--platform=linux/amd64'
    }
    test {
        process.maxForks = 1
        executor.cpus = 2
        executor.memory = '4 GB'
    }
}
