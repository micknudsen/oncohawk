// Starting SLURM allocations, not measured full-reference requirements.
// Override named process settings with a pipeline-specific -c config for your cluster.
process {
    withName: REFERENCE_DOWNLOAD {
        cpus = 1
        memory = '2 GB'
        time = '24h'
    }
    withName: GUNZIP {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
    withName: REFERENCE_VALIDATE {
        cpus = 1
        memory = '16 GB'
        time = '4h'
    }
    withName: BEDTOOLS_MASKFASTA {
        cpus = 1
        memory = '16 GB'
        time = '4h'
    }
    withName: BWAMEM2_INDEX {
        cpus = 1
        memory = '128 GB'
        time = '24h'
    }
    withName: REFERENCE_BUNDLE {
        cpus = 1
        memory = '4 GB'
        time = '4h'
    }
}
