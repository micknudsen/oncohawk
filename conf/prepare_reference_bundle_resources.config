// Starting SLURM allocations, not measured full-reference requirements.
// Override named process settings with a pipeline-specific -c config for your cluster.
process {
    withName: ANNOTATION_FASTA_DECOMPRESS {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: ANNOTATION_FASTA_INDEX {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: ANNOTATION_PREPARE {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withName: REFERENCE_DOWNLOAD {
        cpus = 1
        memory = { 2.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: ALIGNMENT_FASTA_DECOMPRESS {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: REFERENCE_VALIDATE {
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: ALIGNMENT_FASTA_MASK {
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: ALIGNMENT_MAPPER_INDEX {
        cpus = 1
        memory = { 128.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: REFERENCE_BUNDLE_ASSEMBLE {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: ALIGNMENT_FASTA_INDEX {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: ALIGNMENT_SEQUENCE_DICTIONARY_CREATE {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
}
