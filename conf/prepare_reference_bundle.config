params {
    fasta = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz'
    exclusions_bed = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_GRC_exclusions.bed'
    annotation_fasta = 'https://ftp.ensembl.org/pub/release-116/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz'
    vep_cache = 'https://ftp.ensembl.org/pub/release-116/variation/indexed_vep_cache/homo_sapiens_refseq_vep_116_GRCh38.tar.gz'
    annotation_fasta_sha256 = null
    vep_cache_sha256 = null
    annotation_fasta_identity = [:]
    vep_cache_identity = [:]
    outdir = 'reference'
    downloads_dir = 'downloads'
    download_ca_bundle = env('SSL_CERT_FILE') ?: null
    fasta_sha256 = null
    exclusions_bed_sha256 = null
    fasta_identity = [:]
    exclusions_bed_identity = [:]
}

outputDir = params.outdir

process {
    withName: REFERENCE_DOWNLOAD {
        tag = { "${source_label} / ${kind}" }
    }
    withName: 'REFERENCE_VALIDATE|REFERENCE_BUNDLE|ANNOTATION_PREPARE' {
        tag = { reference_label }
    }
    withName: 'GUNZIP|BEDTOOLS_MASKFASTA|BWAMEM2_INDEX|SAMTOOLS_FAIDX|PICARD_CREATESEQUENCEDICTIONARY' {
        tag = { meta.reference_label }
    }
    withName: 'ANNOTATION_GUNZIP|ANNOTATION_FAIDX' {
        tag = { meta.reference_label }
    }
    withName: ANNOTATION_GUNZIP {
        ext.prefix = 'annotation'
    }
    withName: BEDTOOLS_MASKFASTA {
        ext.prefix = 'reference'
    }
    withName: PICARD_CREATESEQUENCEDICTIONARY {
        ext.prefix = 'reference'
        ext.args = '--URI reference.fa'
    }
    withName: BWAMEM2_INDEX {
        ext.prefix = 'reference.fa'
    }
}

profiles {
    slurm {
        includeConfig 'prepare_reference_bundle_resources.config'
    }
    test {
        process {
            withName: BWAMEM2_INDEX {
                memory = '2 GB'
            }
        }
    }
}
