// Copy to a local site.config and replace the paths, partition, and account.
// These paths must be accessible from the submission host and compute nodes.
workDir = '/shared/PROJECT/oncohawk/work'
apptainer.cacheDir = '/shared/PROJECT/oncohawk/apptainer'

process {
    queue = 'REPLACE_WITH_PARTITION'
    // Remove this option if your cluster does not require a SLURM account.
    clusterOptions = '--account=REPLACE_WITH_ACCOUNT'

    // Illustrative allocations for production runs, not measured requirements.
    // Set these according to your cluster and observed task usage.
    withName: GUNZIP {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
    withName: REFERENCE_VALIDATE {
        cpus = 1
        memory = '16 GB'
        time = '4h'
    }
    withName: BEDTOOLS_MASKFASTA {
        cpus = 1
        memory = '16 GB'
        time = '4h'
    }
    withName: BWAMEM2_INDEX {
        cpus = 1
        memory = '128 GB'
        time = '24h'
    }
    withName: REFERENCE_BUNDLE {
        cpus = 1
        memory = '4 GB'
        time = '4h'
    }
    withName: CUTADAPT {
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }
    withName: BWAMEM2_MEM {
        cpus = 8
        memory = '64 GB'
        time = '12h'
    }
    withName: PICARD_MARKDUPLICATES {
        cpus = 2
        memory = '32 GB'
        time = '12h'
    }
    withName: SAMTOOLS_INDEX {
        cpus = 2
        memory = '4 GB'
        time = '4h'
    }
}
