params {
    input = null
    reference_bundle = null
    verify_bundle_checksums = false
    outdir = 'results'
}

outputDir = params.outdir

// Reject collisions before native diagnostic observers can create or replace files.
// Manifest discovery ignores included configurations, so CLI --outdir is available here.
params._oncohawk_output_path = {
    def path = java.nio.file.Path.of(params.outdir.toString()).toAbsolutePath().normalize()
    assert !java.nio.file.Files.exists(path, java.nio.file.LinkOption.NOFOLLOW_LINKS):
        'Alignment output directory already exists; choose a new --outdir'
    path
}()

trace.directory = 'execution'
report.directory = 'execution'
timeline.directory = 'execution'
dag.directory = 'execution'

process {
    withName: CUTADAPT {
        tag = { meta.task_label }
        ext.args = {
            '-m 15 --pair-filter=any' +
                (meta.r1_adapter ? " -a '${meta.r1_adapter}'" : '') +
                (meta.r2_adapter ? " -A '${meta.r2_adapter}'" : '')
        }
        // Leading underscores are excluded from accepted source basenames.
        ext.prefix = { "_${meta.id}" }
    }
    withName: BWAMEM2_MEM {
        tag = { meta.task_label }
        ext.args = { "-Y -R '${meta.read_group}'" }
        // Keep intermediate BAM names disjoint from accepted sample IDs.
        ext.prefix = { "_${meta.id}.mapped" }
    }
    withName: PICARD_MARKDUPLICATES {
        ext.prefix = { meta.sample }
    }
    withName: SAMTOOLS_MERGE {
        // Identical generated RG definitions may span distinct FASTQ chunks.
        ext.args = '-c'
        ext.prefix = { "_sample_${meta.id}.merged" }
    }
}

profiles {
    slurm {
        includeConfig 'oncohawk_resources.config'
    }
}
