// Starting SLURM allocations, not measured full-reference requirements.
// Override named process settings with a pipeline-specific -c config for your cluster.
process {
    withName: VARIANT_CONSEQUENCES_ANNOTATE {
        cpus = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: READS_TRIM {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: READS_ALIGN {
        cpus = { 8 * task.attempt }
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: SAMPLE_ALIGNMENTS_MERGE {
        cpus = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: SAMPLE_DUPLICATES_MARK {
        cpus = { 2 * task.attempt }
        memory = { 32.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: SAMPLE_BAM_INDEX {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: VARIANTS_CALL {
        cpus = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: VARIANTS_FILTER {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
}
