// Starting SLURM allocations, not measured full-reference requirements.
// Override named process settings with a pipeline-specific -c config for your cluster.
process {
    withName: CUTADAPT {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: BWAMEM2_MEM {
        cpus = { 8 * task.attempt }
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: SAMTOOLS_MERGE {
        cpus = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: PICARD_MARKDUPLICATES {
        cpus = { 2 * task.attempt }
        memory = { 32.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: SAMTOOLS_INDEX {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
}
