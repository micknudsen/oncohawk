includeConfig '../../conf/common.config'

params {
    fasta = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz'
    exclusions_bed = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_GRC_exclusions.bed'
    outdir = 'reference'
    downloads_dir = 'downloads'
    download_ca_bundle = env('SSL_CERT_FILE') ?: null
    fasta_sha256 = null
    exclusions_bed_sha256 = null
    fasta_identity = [:]
    exclusions_bed_identity = [:]
}

outputDir = params.outdir

process {
    withName: REFERENCE_DOWNLOAD {
        tag = { "${reference_label} / ${kind}" }
    }
    withName: 'REFERENCE_VALIDATE|REFERENCE_BUNDLE' {
        tag = { reference_label }
    }
    withName: 'GUNZIP|BEDTOOLS_MASKFASTA|BWAMEM2_INDEX' {
        tag = { meta.reference_label }
    }
    withName: BEDTOOLS_MASKFASTA {
        ext.prefix = 'reference'
    }
    withName: BWAMEM2_INDEX {
        ext.prefix = 'reference.fa'
    }
}

profiles {
    slurm {
        includeConfig 'resources.config'
    }
    test {
        process {
            withName: BWAMEM2_INDEX {
                memory = '2 GB'
            }
        }
    }
}
