manifest {
    name = 'micknudsen/oncohawk'
    description = 'Reference preparation and alignment for Oncohawk'
    version = '0.1.0'
    nextflowVersion = '26.10.4'
    mainScript = 'reference.nf'
}

params {
    fasta = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz'
    bed = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_GRC_exclusions.bed'
    outdir = 'reference-bundle'
    fasta_sha256 = null
    bed_sha256 = null
    allow_ncbi_alt_omission = false
}

process {
    cpus = 1
    memory = '2 GB'
    time = '1h'
    withName: BEDTOOLS_MASKFASTA {
        ext.prefix = 'reference'
    }
    withName: BWAMEM2_INDEX {
        ext.prefix = 'reference.fa'
    }
}

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--platform=linux/amd64'
    }
    test {
        process.maxForks = 1
        executor.cpus = 2
        executor.memory = '4 GB'
        process {
            withName: BWAMEM2_INDEX {
                memory = '2 GB'
            }
        }
    }
}
